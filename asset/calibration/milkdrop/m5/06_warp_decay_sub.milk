MILKDROP_PRESET_VERSION=201
PSVERSION=2
[preset00]
fWaveAlpha=1.000
fWaveScale=1.000
nWaveMode=6
wave_r=1.000
wave_g=1.000
wave_b=1.000
zoom=1.010
warp=0.000
mv_a=0.000
warp_1=`shader_body
warp_2=`{
warp_3=`ret = tex2D( sampler_main, uv ).xyz;
warp_4=`ret -= 0.004;
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret = tex2D(sampler_main, uv).xyz;
comp_4=`ret *= 1.00; //gamma
comp_5=`}
