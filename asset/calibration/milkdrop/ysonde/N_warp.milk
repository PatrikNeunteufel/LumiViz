MILKDROP_PRESET_VERSION=201
PSVERSION=2
[preset00]
fWaveAlpha=0.000
fDecay=1.000
zoom=1.000
warp=0.000
mv_a=0.000
ob_a=0.000
ib_a=0.000
warp_1=`sampler sampler_pw_noise_lq;
warp_2=`shader_body
warp_3=`{
warp_4=`ret = tex2D(sampler_pw_noise_lq, uv * 0.25).xyz;
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret = tex2D(sampler_main, uv).xyz;
comp_4=`}
