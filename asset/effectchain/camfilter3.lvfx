            {
                "beatCode": "",
                "code": "// CRT-Monitor: leichte Tonnen-Verzerrung, Scanlines, RGB-Maske, Vignette.\nvec4 farbe(vec2 uv, vec4 src)\n{\n    vec2 d = uv - 0.5;\n    vec2 kruemm = uv + d * dot(d, d) * 0.25;            // Tonnen-Verzerrung\n    if (kruemm.x < 0.0 || kruemm.x > 1.0 || kruemm.y < 0.0 || kruemm.y > 1.0)\n        return vec4(0.0, 0.0, 0.0, 1.0);\n    vec3 farbe = texture(uTex, kruemm).rgb;\n    float zeile = sin(kruemm.y * uResolution.y * 3.14159);\n    farbe *= 0.82 + 0.18 * zeile * zeile;               // Scanlines\n    float spalte = mod(floor(kruemm.x * uResolution.x), 3.0);\n    vec3 maske = spalte < 1.0 ? vec3(1.0, 0.72, 0.72)\n               : spalte < 2.0 ? vec3(0.72, 1.0, 0.72) : vec3(0.72, 0.72, 1.0);\n    farbe *= maske * 1.12;                              // Lochmaske\n    farbe *= 1.0 - 0.55 * dot(d, d) * 2.0;             // Vignette\n    return vec4(farbe, 1.0);\n}\n",
