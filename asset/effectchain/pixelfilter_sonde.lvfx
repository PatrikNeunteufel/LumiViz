{
    "header": {
        "formatVersion": 1,
        "generator": "LumiViz MultiEffect"
    },
    "root": {
        "type": "list",
        "clearEveryFrame": false,
        "children": [
            {
                "type": "shadertoy",
                "name": "Testbild Farbverlauf + Kreis",
                "description": "Stilfilter-Pruefstand (S70): deterministisches Testbild - Farbverlauf, wandernder Kreis, Gitterlinien. Ohne Filter glatt; der Filter muss Kanten/Toene sichtbar umformen.",
                "imageInput": [-1, -1, -1, -1],
                "blend": 0,
                "code": "// LumiViz-Sonde (S70): Verlauf + Kreis + Gitter, ohne Audio\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = fragCoord / iResolution.xy;\n    vec3 grund = vec3(0.15 + 0.7 * uv.x, 0.25 + 0.5 * uv.y, 0.55 - 0.3 * uv.x);\n    vec2 mitte = vec2(0.5 + 0.25 * cos(iTime * 0.7), 0.5 + 0.25 * sin(iTime * 0.9));\n    float kreis = smoothstep(0.18, 0.16, length((uv - mitte) * vec2(iResolution.x / iResolution.y, 1.0)));\n    vec3 farbe = mix(grund, vec3(0.95, 0.85, 0.25), kreis);\n    float gx = step(0.94, fract(uv.x * 10.0));\n    float gy = step(0.94, fract(uv.y * 8.0));\n    farbe = mix(farbe, vec3(0.05), max(gx, gy) * 0.8);\n    fragColor = vec4(farbe, 1.0);\n}\n"
            },
            {
                "type": "pixelFilter",
                "name": "Sonde Pixel-Filter",
                "description": "Stilfilter-Pruefstand (S70): deterministischer Comic-Kern (kein Audio) - Posterize auf 4 Stufen + Sobel-Kantenzug; Verlauf muss zu Stufen werden, Kreis/Gitter bekommen dunkle Konturen. Zwei Laeufe muessen bit-identisch sein.",
                "mixAmount": 1.0,
                "code": "// LumiViz-Sonde (S70): Posterize + Sobel, bewusst ohne Audio\nfloat lum(vec2 p) { return dot(texture(uTex, p).rgb, vec3(0.299, 0.587, 0.114)); }\nvec4 farbe(vec2 uv, vec4 src)\n{\n    vec2 px = 1.0 / uResolution;\n    float gx = lum(uv + vec2(px.x, 0.0)) - lum(uv - vec2(px.x, 0.0));\n    float gy = lum(uv + vec2(0.0, px.y)) - lum(uv - vec2(0.0, px.y));\n    float kante = smoothstep(0.08, 0.30, length(vec2(gx, gy)));\n    vec3 ton = floor(src.rgb * 4.0 + 0.5) / 4.0;\n    return vec4(ton * (1.0 - 0.85 * kante), 1.0);\n}\n"
            }
        ]
    }
}
