            {
                "beatCode": "",
                "blendOut": 1,
                "children": [
                    {
                        "debugGrid": false,
                        "debugMotionVectors": false,
                        "enabled": true,
                        "meshX": 32,
                        "meshY": 24,
                        "name": "martin - stratospheric turbulences 2",
                        "preset": {
                            "header": {
                                "formatVersion": 1,
                                "generator": "LumiViz Milkdrop",
                                "type": "milkdrop"
                            },
                            "preset": {
                                "additiveWaves": false,
                                "aspektOriginal": true,
                                "audioOriginal": true,
                                "basicWaveEnabled": true,
                                "blur1EdgeDarken": 0,
                                "blur1Max": 1,
                                "blur1Min": 0,
                                "blur2Max": 0.7,
                                "blur2Min": 0,
                                "blur3Max": 1,
                                "blur3Min": 0,
                                "brighten": false,
                                "compShader": "#define sat saturate\n#define snl sampler_noise_lq\n#define snh sampler_noise_hq\nsampler sampler_pw_noise_lq;\nfloat3 neon, neons, col, noise, mod, mod2, stars, lg;\nfloat2 water, uv0, uv1, uv2, uv5, uvw, dz, tuv0, tuv, tshift;\nfloat li, near, z, k1, k2, ftu, nshape, nshape2, nmask, wmask, skym, skym1;\nfloat istube;\nstatic int tubes = q6;\nstatic float3 bcol = normalize(rand_preset) * 0.5;;\nstatic float3 ocol = normalize (slow_roam_cos+bcol)*1.5;\nstatic float trad = q5, srad = sqrt(trad), tlen = q7; \n\nfloat tria (float x) {return abs(2*frac(x/2)-1);}\n\nfloat aTan2(float y, float x) {float angle;\t float abs_y = abs(y);\nif (x >= 0) {float r = (x - abs_y) / (x + abs_y); angle = 1-r;} else {float r = (x + abs_y) / (abs_y - x); angle = 3-r; }\t\nreturn (y < 0 ? -angle : angle)/4;}\n\nshader_body {\nuv += float2(q17,q18);\nuv = mul((uv-0.5)/aspect.yx, float2x2 (sin(q8),cos(q8),-cos(q8),sin(q8)))+q9;\nuv1 = (uv-0.5);\nuvw = (uv1*aspect.yx)*0.8+0.5;\n\nwmask = (uvw.x<1) * (uvw.x>0)* (uvw.y<1) * (uvw.y>0);\ntuv0 = float2 (.5/length (uv1), aTan2(uv1.y,-uv1.x)) ;\nnear = sat (8*length(uv1))*0+1;\ntuv = tuv0 + float2(q19,0);\n\nftu = frac (tuv.y*tubes/2)-0.5; \nnshape = saturate(1-1/trad*pow (ftu,2));\ntuv.x -= pow(nshape,0.2)*6*srad/tubes*tuv0.x;\nmod = tex2D(sampler_pw_noise_lq,tuv.x*0.0002+rand_preset.z);\nmod2= tex2D(sampler_pw_noise_lq,tuv.x*0.00007+rand_preset.y);\n\nk1 = tuv.x*6*mod.x;\nk2 = tuv.y*2*M_PI*tubes/2-4.7;\nskym  = sat(sin(k2))*(sin(k1)+mod.y)*2;\nskym1 = sat(sin(k2)+.4)*(sin(k1+frac(q19/8)*2*M_PI)+mod.y)*2 ;\nskym1 = skym1 > .1+mod2.z;\n\nk1 = abs(sin(tuv.x/tlen*M_PI*2*int(1+mod2.x*3.1)));\nnshape *= sat(1.5*k1); \nistube = sat (20*nshape-2); \n\nfloat2 sc = float2(0.005,0.25*mod.z);\nuv5  = tuv*float2(0.25/tlen,tubes/16.0); \ntuv += 0.25*int(8*skym)*!istube;\nskym = sat (1+8*mod2.z-8*skym);\nnoise = near*!istube* (0.1+tex2D(sampler_pw_noise_lq,tuv*sc)-tex2D(sampler_pw_noise_lq,(tuv+0.003)*sc)*0.75).r;\ncol = (tex2D(sampler_pw_noise_lq,uv5/32)+0.1);\n\nnshape2 = sat(q2+2*abs(sin(mod2.z*12*tan(ftu/srad)+q1*cos(q3*int(8*uv5.x)))));\nneon = (0.3+nshape)*nshape2*istube*col;\nneons= sat(k1)* saturate(1-8/tubes*abs(ftu)) *col;\n\nfloat dir = (int(uv5.y*16)%tubes)/2;\nnmask = frac(((q4*uv5.x*8.0) *q20-q21)) < q22;\nnmask *=  sat(q26*(tria((uv5.y*16.0+1)/q25+q27*2)-1)+1) ; \n\nret = (neon + neons*noise)* nmask*near*1.1;\nuv2 = (uvw-0.5)*0.15+0.5;\nlg = GetBlur1(frac (uv2))*float3(1,1,0);\nlg += lum(lg)+0.1;\nret += noise* lg*q11*near*!istube;\n\nfloat3 back = pow(uv.x-0.2,3)*bcol+GetPixel(uvw).b*wmask*ocol;\nret = lerp (ret, back, sat(1-10*length(uv1))) *skym;\n\nret += (GetPixel(uvw)+2*GetBlur2(uvw))*wmask*float3(0.8,0.8,0);\nstars = 0;\nint n = 1, sanz = 4;\nfloat t0 = q19*0.005;\nwhile (n <= sanz) {\n  float arg = (1.0*n/sanz-t0); \n  float dist = frac(arg);\n  float inten =  sat(1-dist); \n  float2 uv4 = 4*64 * dist* uv1;\n  float2 snoise = tex2D (sampler_pw_noise_lq,uv4/256);\n  float smask = sat(1-snoise.x)*100+2;\n  stars += (snoise.x>0.97)*inten* sat(1-2*pow(smask*length(frac(uv4)-0.5),2));\n  stars += inten*sat(tex2D(sampler_noise_hq,uv4*0.002).r-0.8)*bcol;\nn++;\n}\nret = (ret)+(stars+back)*sat(1-4*skym*near);\n//li =  sat (1.2-1*abs(-uv.y+0.5)-2*uv.x);\nli = sat (1-2*abs(tuv0.y));\nret += li*near*noise*skym*skym1*(bcol+0.25) + nshape*0.05;\n\nuv2 = frac (tuv0*float2(0.003,tubes/2)+float2(.51,0));\nret += GetBlur1(uv2)*float3(1,1,0)*istube/2;\nuv2 = frac (tuv0*float2(0.05,3.5+0*tubes/2)+float2(.15,0));\nret += GetBlur1(uv2).b*istube*ocol/4*sat (1-3*li);\n\nret += q12*exp(-6*length(0.5*tria(2*q10+tuv0.x*0+tuv0.y+tex2D(snh,tuv0.y)))) * (istube/4+!skym) * float3 (0.25,0,0.5) ;\n\nret += uv.x*0.02/length(frac(1.5*uv1-float2(rand_preset.xy/2))-0.5)*!skym*bcol;\n//ret = GetPixel(uv).b;\n}\n//Martin\n",
