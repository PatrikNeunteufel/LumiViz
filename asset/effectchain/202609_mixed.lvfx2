                                "perFrameInit": "n = 0; loop (20000, megabuf(n)=0; gmegabuf(n)=0; n +=1; );MINBPM = 30; MAXBPM = 220; num_res = 100;index = 0;loop (num_res,  n = 12*index;  BPM      = minbpm * pow(maxbpm/minbpm,index/num_res);  gmegabuf(n) = BPM;  index += 1;);pi = 3.1416;OCTAVE = (num_res) * log(2) / log (MAXBPM / MINBPM);q7 = .15; q8 =  rand(2)-0.25; q16 = 1.8; start = 1; travel = 0; RotZ = 0; t0 = time+3;cran0 = rand(1);trelx = 0;  trely = 0; trelz = 0;reg20 = 1; reg21 = 0; reg22 = 0; reg23 = 0; reg24 = 1; reg25 = 0; reg26 = 0; reg27 = 0; reg28 = 1;while (exec2(  ran1 = rand(8); ran2 = rand(8); ran3 = rand(8);  PosX = rand(8); PosY = rand(8); PosZ = rand(8);   c1 = cos(ran1); c2 = cos(ran2); c3 = cos(ran3);   s1 = sin(ran1); s2 = sin(ran2); s3 = sin(ran3);  reg20 = c2*c1; reg21 = c2*s1; reg22 = -s2;  reg23 = s3*s2*c1 - c3*s1; reg24 = s3*s2*s1 + c3*c1; reg25 = s3*c2;  reg26 = c3*s2*c1 + s3*s1; reg27 = c3*s2*s1 - s3*c1; reg28 = c3*c2;      dist = 0.001;  while (exec2(    uvx = reg26*dist/q7; uvy = reg27*dist/q7; uvz = reg28*dist/q7;    uvx += PosX; uvy += PosY; uvz += PosZ;    uvx = 1+2*((uvx/4+30.5 - int(uvx/4+30.5))-.5);    uvy = 2+2*((uvy/4+30.5 - int(uvy/4+30.5))-.5);    uvz = 3+2*((uvz/4+30.5 - int(uvz/4+30.5))-.5);    uvx0 = uvx+q8; uvy0 = uvy+q8; uvz0 = uvz+q8;    loop (7+1,      uvx = if (uvx > 1, 2-uvx, if(uvx < -1, -2-uvx, uvx));      uvy = if (uvy > 1, 2-uvy, if(uvy < -1, -2-uvy, uvy));      uvz = if (uvz > 1, 2-uvz, if(uvz < -1, -2-uvz, uvz));      slen = uvx*uvx + uvy*uvy + uvz*uvz;      uvx = if (slen < 0.25, uvx*4, if (slen < 1, uvx/slen, uvx)) *2.6 + uvx0;       uvy = if (slen < 0.25, uvy*4, if (slen < 1, uvy/slen, uvy)) *2.6 + uvy0;       uvz = if (slen < 0.25, uvz*4, if (slen < 1, uvz/slen, uvz)) *2.6 + uvz0;     );    len = sqrt(uvx*uvx + uvy*uvy + uvz*uvz);    dist *= 1.05;  ,(dist < 0.6)*(len > 30)));,(dist < .06))); ",
