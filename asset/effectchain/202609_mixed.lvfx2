                                "perFrame": "dt = 1/fps;dec_s = 1-.015*30/fps; dec_m = 1-0.1*30/fps; dec_f = 0.7;vol = vol*0.3 + 0.7*(bass_att + mid_att + treb_att)/3; vol_ = vol_*dec_f + (1-dec_f)*vol;avg = avg*dec_m + (1-dec_m)*vol;is_beat = above(vol, 1.75*peak) * above (time, t0+.25);t0 = if(is_beat,time,t0);peak = if (is_beat, vol, peak*dec_m);index = (index + is_beat) %32;index2 = (index2 + is_beat*bnot(index))%16;fg = BPM/60; Q=1.8; omega = 6.283*min(0.5,fg/fps); tcos = cos (omega); alpha = sin(omega)/(2*Q);b0=(1-tcos)/2; b1=1-tcos; b2=(1-tcos)/2; a0=1+alpha; a1=-2*tcos; a2=1-alpha;b0a0=b0/a0; b1a0=b1/a0; b2a0=b2/a0; a1a0=a1/a0; a2a0=a2/a0;X = vol; LastOut= b0a0*X + b1a0*in1 + b2a0*in2 - a1a0*ou1 - a2a0*ou2;in2 =in1; in1 =X; ou2 =ou1;  ou1 =LastOut; X =LastOut;BiVol=X;maxind = 0; qavg = 0.1; i=0; Excite = (vol-vol_);loop (num_res,  n = i*8;  Freq  = (i/(num_res-1)+minbpm/(maxbpm-minbpm))*(maxbpm-minbpm)/60;  Feder = sqr(Freq*6.2832);  megabuf (n+4) = megabuf(n+1); megabuf (n+1) *= 1-0.25*dt;   EC_Steps = int (10*Freq*dt)+1;  loop (EC_Steps,     Kraft = Excite - Feder*megabuf(n + 2) ;    megabuf (n+1) += Kraft        * dt/EC_Steps;    megabuf (n+2) += megabuf(n+1) * dt/EC_Steps;  );  beatcos = megabuf(n+1);  beatsin = megabuf(n+2)*Freq*6.2832;  quad = sqrt (pow(beatsin,2) + pow(beatcos,2));  megabuf (n+3) = megabuf(n+3) *dec_m +  quad* (1-dec_m);  if (megabuf(n+3) > megabuf (maxind*8+3), maxind =i,0);  qavg = qavg+pow (megabuf(n+3),2);  i += 1;);qavg = sqrt (qavg/num_res); qdev = 0; i =0; loop (num_res, qdev += pow(megabuf(i+3)-qavg,2); i += 8; );qdev = sqrt (qdev/num_res);BPM =   (maxind/(num_res-1)+minbpm/(maxbpm-minbpm))*(maxbpm-minbpm);m1 = maxind*8;certain = certain * dec_m + (1-dec_m) * megabuf(m1+3)/qavg;dbl_beat = megabuf(m1+1) * megabuf (m1+4) < 0;sgl_beat = dbl_beat * (megabuf (m1+4) < 0);pulse = (megabuf(m1+2) > 0)-0.5;bcount += dbl_beat;is_rbeat  = dbl_beat && (bcount%2==0);bcount2 += is_rbeat;trel1 += BPM/60*dt;trig2 = is_beat && (index%12==0);r1 