                                "blur3Max": 0.3,
                                "blur3Min": 0,
                                "brighten": false,
                                "compShader": "#define sat saturate\nsampler sampler_pw_noise_lq;\nfloat stars, smask, gmask;\nfloat2 dz, uv0, uv1,uv2, uv3, uv4,smoke;\nfloat3 rs, rs2, rs0, gnd, gnd1, gnd2,screen,rip;\nstatic const float3 t = float3(q20,q23,q26), s = float3(q22,q25,q28);\nstatic const float3 ts = cross(t,s);\nstatic const float2 hor = texsize.zw*float2(2,0), ver = texsize.zw*float2(0,2);\nstatic const float3 centre = float3(q7,q8,q9);\nstatic const float abo=sat(40*q27), gk = max(1,10/q9), tstars = time*0.01;\n\nfloat3 col (float c) {return pow (c,1+1.5*roam_sin);}\n\nfloat2 noise3 (float2 uvi) {uvi*=0.75;\n  return sat(tex2D(sampler_noise_hq,uvi)\n         +tex2D(sampler_noise_hq,uvi*4)/3-0.4); }\n\nfloat3 tile (float2 uvi)\n  {return tex2D(sampler_pw_noise_lq,uvi);} \n\nfloat3 project () {float z; \n  z = .08/mul(ts,screen); //z = min(1.,max(-1,z));\n  return float3((mul(float2x3(t,s),cross(ts,cross(centre,screen)))*z),-z);}\n\nshader_body {\nuv += 0*texsize.zw/2; uv0 = uv;\ndz.x = 2.0*GetBlur1(uv+hor*gk).g-2.0*GetBlur1(uv-hor*gk).g;\ndz.y = 2.0*GetBlur1(uv+ver*gk).g-2.0*GetBlur1(uv-ver*gk).g;\ndz *= GetBlur1(uv).g > 0.06;\ndz *= max(1,GetBlur2(uv).g*8);\n\nscreen = float3 ((uv-0.5)*aspect.xy+dz*0.25,1);\nrs = project(); float lrs = length(rs.xy);\ngmask = sat (1-.1*lrs) * (rs.z>0);\ngmask *= sat (2-10*min(abs(rs.x),abs(rs.y)));\nfloat gm0 = gmask;\nuv2 = (rs)*0.15/(1+lrs*0.25);\nuv2 += float2(0,q30)* (abs (uv2.x) < 3.0/4/64);\n\nrip = tex2D(sampler_noise_lq,uv2*32*tex2D(sampler_pw_noise_lq,uv2));\ngnd1 = tile(uv2); \ngnd2 = tile(uv2+0.0002*float2(q17,q18)); \ngmask = sat (gmask*3-2*dot(gnd1,gnd1));\ngnd  = sat(gnd1 + lum(gnd1-gnd2)*3);\nfloat zblend = sat(abo-lrs/8);\nsmoke = 0.06*noise3(uv2-tstars*4).xy *zblend;\n\nstars = 0; smask = 0;\nuv4 = uv2*.1 +tstars*float2(1,0.02) + 0.01*gnd;\nsmask = tex2D (sampler_pw_noise_lq,uv4)>.8;\nstars = 1/length(abs(frac(uv4*256+ rip*0.1)-.5))*smask;\n\nuv4 = uv2*.1 +tstars*float2(0.02,1) + 0.01*gnd;\n//uv4 = uv4.yx;\nsmask = tex2D (sampler_pw_noise_lq,uv4)>.8;\n//stars += 1/length(abs(frac(uv4*256+ rip*0.1)-.5))*smask;\n\nret.b += (1-uv.y)*0.2;\nret += gnd*gmask*(.15+stars*stars*0.01)*abo;\n\n// Dioden\nuv4 = uv0+dz*0.05;\nfloat3 dio = max(1.5*max(GetPixel(uv4).r,GetBlur1(uv4).r),GetBlur3(uv4).r);\nret += col(dio)*q3;\n\n// Spiegelung\nfloat2 dref = rip.xy*0.02;\nfloat2 uvm = uv4-dref;\nfloat3 mirr = GetBlur1(uvm).b;\nret += gmask*abo * (uv0.y < 0.99)* (uv0.y > 0.01)* col(mirr)*(1+gnd) ;\n\n//smoke\nret += smoke.x*q19;\n\n//orb\nuv1 = ((uv0-0.5)-float2(q15,-q16))*aspect.xy+dz*0.2;\nret += 0.00015/pow(length(uv1),2)*treb;\nuv1 = ((uv0-0.5)-float2(q5,-q6))*aspect.xy+rip*.02;\nret += 0.0007/pow(length(uv1+dref),2)*abo*treb*gnd*gmask;\n\n\n//Glas\nfloat refl = GetBlur1(uv0+dz*0.25).g/2;\nret += refl*(1+roam_cos);\n\n//back light\nfloat bl = 0;\nuv1 = ((uv0-0.5)-rs*0-float2(q1,-q2))*aspect.xy+dz*4;\nbl += .07/length(uv1)*sat(1-gm0);;\nuv1 = ((uv0-0.5)-rs*0-float2(q10,-q12))*aspect.xy+gnd*0.1+dz*2+rip*.0;\nbl += pow(.07/length(uv1),2)*gmask;\n\nret += q31*bl*(1+mid_att/2)*sat(1-smoke.x*32*rand_preset.x)*roam_cos;\n\nret = 1-exp(-ret*1.8);\n}\n\n//-------------------------------------------\n//Written by martin\n\n",
