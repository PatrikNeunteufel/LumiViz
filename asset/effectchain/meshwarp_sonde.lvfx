        "children": [
            {
                "type": "shadertoy",
                "name": "Testbild UV-Gitter",
                "description": "G1-Pruefstand (S69): deterministisches Linien-Gitter als Warp-Opfer - ohne Warp exakt gerade Linien.",
                "imageInput": [-1, -1, -1, -1],
                "blend": 0,
                "code": "// LumiViz-Sonde (eigenes Testbild, S69): UV-Verlauf + Gitterlinien\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    vec2 uv = fragCoord / iResolution.xy;\n    float gx = step(0.92, fract(uv.x * 12.0));\n    float gy = step(0.92, fract(uv.y * 9.0));\n    float linie = max(gx, gy);\n    fragColor = vec4(mix(vec3(0.2 * uv.x, 0.2 * uv.y, 0.1), vec3(1.0), linie), 1.0);\n}\n"
            },
            {
                "type": "meshWarp",
                "name": "Sonde Mesh Warp",
                "description": "G1-Pruefstand (S69): deterministischer Sinus-Warp (kein Audio) - die Gitterlinien des Testbilds muessen wellig werden; mit identischem Seed/Frame reproduzierbar.",
                "gridX": 96,
                "gridY": 72,
                "mixAmount": 1.0,
                "wrapUv": true,
                "code": "// LumiViz-Sonde (S69): zeitgetriebener Sinus-Warp, ohne Audio\nvec2 warp(vec2 uv)\n{\n    uv.x += 0.03 * sin(uv.y * 14.0 + uTime * 1.7);\n    uv.y += 0.03 * sin(uv.x * 11.0 - uTime * 1.3);\n    return uv;\n}\n"
            }
        ]
    }
