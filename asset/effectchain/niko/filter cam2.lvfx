                        "fan": 360,
                        "forceCode": "// traege Stroemung, Pegel schiebt sanft\nvec2 kraft(vec2 pos, vec2 vel, float alter)\n{\n    vec2 d = pos - vec2(0.5);\n    return vec2(-d.y, d.x) * 0.05 + vec2(0.02 * sin(uTime * 0.3), 0.01 * vol);\n}\n",
                        "frameCode": "speed=0.4+ba*0.7*bass;",
                        "gravityX": 0.22000000000000008,
                        "gravityY": -0.3200000000000001,
                        "initCode": "ba=1;",
                        "lifeJitter": 0.6,
                        "lifeSeconds": 10.999999999999993,
                        "name": "GPU Particles",
                        "scriptsActive": false,
                        "sizeEndFactor": 4,
                        "sizePx": 26,
                        "spawnSpread": 0.39500000000000024,
