      {
        "type": "shadertoy",
        "name": "24_ozean_weite",
        "description": "Generiert aus asset/shadertoys/24_ozean_weite.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
