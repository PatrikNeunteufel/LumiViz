      {
        "type": "shadertoy",
        "name": "46_feuerwerk_nacht",
        "description": "Generiert aus asset/shadertoys/46_feuerwerk_nacht.{image,bufferA}.glsl (Multipass).",
        "imageInput": [
          0,
