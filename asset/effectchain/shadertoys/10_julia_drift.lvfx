    "children": [
      {
        "type": "shadertoy",
        "name": "10_julia_drift",
        "description": "Generiert aus asset/shadertoys/10_julia_drift.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
