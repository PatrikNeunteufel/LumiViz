      {
        "type": "shadertoy",
        "name": "18_feuer_saeule",
        "description": "Generiert aus asset/shadertoys/18_feuer_saeule.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
