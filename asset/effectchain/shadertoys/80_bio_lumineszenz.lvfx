    "children": [
      {
        "type": "shadertoy",
        "name": "80_bio_lumineszenz",
        "description": "Generiert aus asset/shadertoys/80_bio_lumineszenz.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
