    "children": [
      {
        "type": "shadertoy",
        "name": "66_opal_schimmer",
        "description": "Generiert aus asset/shadertoys/66_opal_schimmer.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
