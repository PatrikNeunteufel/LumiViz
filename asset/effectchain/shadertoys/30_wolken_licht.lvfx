    "children": [
      {
        "type": "shadertoy",
        "name": "30_wolken_licht",
        "description": "Generiert aus asset/shadertoys/30_wolken_licht.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
