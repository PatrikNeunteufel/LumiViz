    "children": [
      {
        "type": "shadertoy",
        "name": "36_mandel_zoom",
        "description": "Generiert aus asset/shadertoys/36_mandel_zoom.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
