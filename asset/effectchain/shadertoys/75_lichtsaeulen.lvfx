    "children": [
      {
        "type": "shadertoy",
        "name": "75_lichtsaeulen",
        "description": "Generiert aus asset/shadertoys/75_lichtsaeulen.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
