      {
        "type": "shadertoy",
        "name": "43_zell_kolonie",
        "description": "Generiert aus asset/shadertoys/43_zell_kolonie.{image,bufferA}.glsl (Multipass).",
        "imageInput": [
          0,
          -1,
          -1,
