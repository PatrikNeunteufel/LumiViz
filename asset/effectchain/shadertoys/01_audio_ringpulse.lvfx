    "children": [
      {
        "type": "shadertoy",
        "name": "01_audio_ringpulse",
        "description": "Generiert aus asset/shadertoys/01_audio_ringpulse.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
