    "children": [
      {
        "type": "shadertoy",
        "name": "61_zahnrad_werk",
        "description": "Generiert aus asset/shadertoys/61_zahnrad_werk.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
