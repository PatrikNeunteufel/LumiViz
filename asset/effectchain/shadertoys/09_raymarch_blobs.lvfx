    "children": [
      {
        "type": "shadertoy",
        "name": "09_raymarch_blobs",
        "description": "Generiert aus asset/shadertoys/09_raymarch_blobs.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
