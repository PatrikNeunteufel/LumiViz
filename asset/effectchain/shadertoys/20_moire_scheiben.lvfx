    "children": [
      {
        "type": "shadertoy",
        "name": "20_moire_scheiben",
        "description": "Generiert aus asset/shadertoys/20_moire_scheiben.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
