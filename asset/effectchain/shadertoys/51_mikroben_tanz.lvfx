      {
        "type": "shadertoy",
        "name": "51_mikroben_tanz",
        "description": "Generiert aus asset/shadertoys/51_mikroben_tanz.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
