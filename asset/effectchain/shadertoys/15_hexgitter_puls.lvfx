    "children": [
      {
        "type": "shadertoy",
        "name": "15_hexgitter_puls",
        "description": "Generiert aus asset/shadertoys/15_hexgitter_puls.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
