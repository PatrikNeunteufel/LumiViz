    "children": [
      {
        "type": "shadertoy",
        "name": "12_kaleidoskop_beat",
        "description": "Generiert aus asset/shadertoys/12_kaleidoskop_beat.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
