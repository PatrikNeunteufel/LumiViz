    "children": [
      {
        "type": "shadertoy",
        "name": "68_kristall_hoehle",
        "description": "Generiert aus asset/shadertoys/68_kristall_hoehle.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
