    "children": [
      {
        "type": "shadertoy",
        "name": "04_plasma_interferenz",
        "description": "Generiert aus asset/shadertoys/04_plasma_interferenz.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
