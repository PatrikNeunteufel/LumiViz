      {
        "type": "shadertoy",
        "name": "40_spiegel_kammer",
        "description": "Generiert aus asset/shadertoys/40_spiegel_kammer.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
