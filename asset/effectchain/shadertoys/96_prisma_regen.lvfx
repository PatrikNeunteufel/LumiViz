    "children": [
      {
        "type": "shadertoy",
        "name": "96_prisma_regen",
        "description": "Generiert aus asset/shadertoys/96_prisma_regen.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
