    "children": [
      {
        "type": "shadertoy",
        "name": "92_magnet_neuronen",
        "description": "Generiert aus asset/shadertoys/92_magnet_neuronen.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
