    "children": [
      {
        "type": "shadertoy",
        "name": "99_leuchtender_garten",
        "description": "Generiert aus asset/shadertoys/99_leuchtender_garten.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
