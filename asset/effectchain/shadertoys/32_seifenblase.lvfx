    "children": [
      {
        "type": "shadertoy",
        "name": "32_seifenblase",
        "description": "Generiert aus asset/shadertoys/32_seifenblase.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
