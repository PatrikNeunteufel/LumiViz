    "children": [
      {
        "type": "shadertoy",
        "name": "78_gluehwuermchen",
        "description": "Generiert aus asset/shadertoys/78_gluehwuermchen.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
