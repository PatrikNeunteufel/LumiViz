    "children": [
      {
        "type": "shadertoy",
        "name": "39_blitz_gewitter",
        "description": "Generiert aus asset/shadertoys/39_blitz_gewitter.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
