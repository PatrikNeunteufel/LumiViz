    "children": [
      {
        "type": "shadertoy",
        "name": "57_phoenix_flug",
        "description": "Generiert aus asset/shadertoys/57_phoenix_flug.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
