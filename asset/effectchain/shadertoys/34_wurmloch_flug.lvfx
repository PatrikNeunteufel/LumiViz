    "children": [
      {
        "type": "shadertoy",
        "name": "34_wurmloch_flug",
        "description": "Generiert aus asset/shadertoys/34_wurmloch_flug.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
