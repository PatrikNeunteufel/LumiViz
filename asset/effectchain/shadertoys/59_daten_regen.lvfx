      {
        "type": "shadertoy",
        "name": "59_daten_regen",
        "description": "Generiert aus asset/shadertoys/59_daten_regen.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
