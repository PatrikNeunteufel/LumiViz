    "children": [
      {
        "type": "shadertoy",
        "name": "72_sternen_tor",
        "description": "Generiert aus asset/shadertoys/72_sternen_tor.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
