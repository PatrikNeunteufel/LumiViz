      {
        "type": "shadertoy",
        "name": "95_lava_wurmloch",
        "description": "Generiert aus asset/shadertoys/95_lava_wurmloch.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
