    "children": [
      {
        "type": "shadertoy",
        "name": "02_spektrum_stadt",
        "description": "Generiert aus asset/shadertoys/02_spektrum_stadt.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
