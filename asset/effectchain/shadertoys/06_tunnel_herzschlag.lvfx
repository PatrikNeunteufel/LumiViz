    "children": [
      {
        "type": "shadertoy",
        "name": "06_tunnel_herzschlag",
        "description": "Generiert aus asset/shadertoys/06_tunnel_herzschlag.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
