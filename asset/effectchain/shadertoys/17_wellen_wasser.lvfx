    "children": [
      {
        "type": "shadertoy",
        "name": "17_wellen_wasser",
        "description": "Generiert aus asset/shadertoys/17_wellen_wasser.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
