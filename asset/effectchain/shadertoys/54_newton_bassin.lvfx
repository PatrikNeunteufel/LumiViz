      {
        "type": "shadertoy",
        "name": "54_newton_bassin",
        "description": "Generiert aus asset/shadertoys/54_newton_bassin.glsl (SSOT dort; Shadertoy-portabel).",
        "imageInput": [
          4,
          -1,
          -1,
