                "type": "fadeout",
                "name": "Afterglow",
                "fadeLen": 4
            },
            {
                "type": "superScope",
                "name": "Bass Spiral",
                "description": "A rotating spiral, speed follows the bass - feed for the fourfold fold.",
                "initCode": "n=320; t=0; dreh=0;",
                "frameCode": "t=t+0.02; dreh=dreh+0.01+0.03*bass;",
                "pointCode": "r=i*0.45; w=i*18.85+dreh; x=cos(w)*r; y=sin(w)*r; red=0.8+0.2*sin(w); green=0.5+0.4*sin(t*1.7); blue=1;",
                "pointCount": 320,
                "renderMode": 1,
                "lineWidth": 4.0
            },
            {
                "type": "meshWarp",
                "name": "Hall of Mirrors",
                "description": "Kaleidoscope: rotate first (time + highs), then fold fourfold, a slight outward breathing cascades through the feedback.",
                "gridX": 96,
                "gridY": 72,
                "mixAmount": 1.0,
                "wrapUv": true,
                "code": "vec2 warp(vec2 uv)\n{\n    vec2 d = uv - 0.5;\n    float dreh = 0.15 * uTime + 0.4 * treb;\n    float s = sin(dreh);\n    float c = cos(dreh);\n    d = mat2(c, -s, s, c) * d;\n    d = abs(d) * 1.04;\n    return 0.5 + d;\n}\n"
            }
        ]
    }
