                    {
                        "beatCode": "",
                        "code": "// Tunnel-Sog: zieht das Bild je Frame zur Mitte und dreht leicht -\n// uebers Feedback entsteht der klassische Tunnel (Quelle davor noetig).\nvec2 warp(vec2 uv)\n{\n    vec2 d = uv - 0.5;\n    float winkel = 0.06 + 0.05 * bass;\n    float s = sin(winkel);\n    float c = cos(winkel);\n    float sog = 0.97 - 0.04 * bass;\n    return 0.5 + mat2(c, -s, s, c) * d * sog;\n}\n",
                        "description": "Kaleidoskop: erst drehen (Zeit + Hoehen), dann vierfach falten, leichtes Auswaertsatmen kaskadiert uebers Feedback.",
                        "enabled": true,
                        "frameCode": "",
                        "gridX": 96,
                        "gridY": 72,
                        "initCode": "",
                        "mixAmount": 1,
                        "name": "Spiegelkabinett",
                        "type": "meshWarp",
                        "wrapUv": false
                    },
                    {
                        "beatCode": "",
                        "code": "// Bass-Swirl (Palette-Starter): Drehung um die Mitte, Bass verstaerkt\nvec2 warp(vec2 uv)\n{\n    vec2 d = uv - 0.5;\n    float winkel = 0.30 * sin(uTime * 0.4) + 1.2 * bass * exp(-6.0 * dot(d, d));\n    float s = sin(winkel);\n    float c = cos(winkel);\n    float zoom = 1.0 + 0.03 * sin(uTime * 0.9) + 0.05 * treb;\n    return 0.5 + mat2(c, -s, s, c) * d / zoom;\n}\n",
                        "description": "Kaleidoskop: erst drehen (Zeit + Hoehen), dann vierfach falten, leichtes Auswaertsatmen kaskadiert uebers Feedback.",
                        "enabled": true,
                        "frameCode": "",
                        "gridX": 96,
                        "gridY": 72,
                        "initCode": "",
                        "mixAmount": 1,
                        "name": "Spiegelkabinett",
                        "type": "meshWarp",
                        "wrapUv": true
                    },
                    {
                        "beatCode": "",
                        "code": "// Wellengang: gekreuzte Sinuswellen, Mitten heben die Amplitude\nvec2 warp(vec2 uv)\n{\n    float amp = 0.015 + 0.03 * mid;\n    uv.x += amp * sin(uv.y * 12.0 + uTime * 1.6);\n    uv.y += amp * sin(uv.x * 9.0 - uTime * 1.1);\n    return uv;\n}\n",
                        "description": "Kaleidoskop: erst drehen (Zeit + Hoehen), dann vierfach falten, leichtes Auswaertsatmen kaskadiert uebers Feedback.",
