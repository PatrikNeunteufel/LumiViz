{
    "header": {
        "formatVersion": 1,
        "generator": "LumiViz MultiEffect"
    },
    "root": {
        "type": "list",
        "clearEveryFrame": false,
        "children": [
            {
                "type": "fadeout",
                "name": "Nachleuchten",
                "fadeLen": 8
            },
            {
                "type": "superScope",
                "name": "Audio-Ring",
                "description": "Ring pulsiert mit der Waveform - das Futter fuer den Tunnel-Sog dahinter.",
                "initCode": "n=220; t=0;",
                "frameCode": "t=t+0.03;",
                "pointCode": "r=0.32+0.28*v; w=i*6.28318+t; x=cos(w)*r; y=sin(w)*r; red=0.5+0.5*sin(t+i*6.28318); green=0.4+0.4*sin(t*1.3+2.0); blue=1-0.5*red;",
                "pointCount": 220,
                "renderMode": 1,
                "lineWidth": 2.0
            },
            {
                "type": "meshWarp",
                "name": "Tunnel-Sog",
                "description": "Zieht jeden Frame zur Mitte und dreht mit dem Bass - der Feedback-Tunnel entsteht aus den Ringen davor (Werks-Voreinstellung Tunnel-Sog).",
                "gridX": 96,
                "gridY": 72,
                "mixAmount": 1.0,
                "wrapUv": false,
                "code": "vec2 warp(vec2 uv)\n{\n    vec2 d = uv - 0.5;\n    float winkel = 0.06 + 0.05 * bass;\n    float s = sin(winkel);\n    float c = cos(winkel);\n    float sog = 0.97 - 0.04 * bass;\n    return 0.5 + mat2(c, -s, s, c) * d * sog;\n}\n"
            }
        ]
    }
}
