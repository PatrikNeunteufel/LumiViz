set(SICHTTEST_SHA256  "bc4849c1392dcd915f6d15145316503d9f410580ba664a638d9b25b6fd0c0b77")

# Fallback-Quellen, wenn die URL nicht erreichbar ist. Relative Pfade gelten ab
