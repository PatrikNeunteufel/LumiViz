set(SICHTTEST_SHA256  "03cac8d157ed363b28a5f40d333c6ea554cf3aed0c19e35f67ecd348714ff0b6")

# Fallback-Quellen, wenn die URL nicht erreichbar ist. Relative Pfade gelten ab
# dem Ordner dieser Datei.
