      {
        "type": "shadertoy",
        "name": "schritt_12",
        "description": "Schritt 12 - Kohaerenz-Politur: das fertige Werk (generiert aus CompositeTransitions-tutorial.md, SSOT dort)",
        "imageInput": [
          0,
