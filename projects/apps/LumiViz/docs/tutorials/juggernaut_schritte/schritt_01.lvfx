  "header": {
    "formatVersion": 1,
    "generator": "LumiViz make_schritte (Juggernaut-Tutorial)"
  },
  "root": {
    "type": "list",
    "clearEveryFrame": false,
    "children": [
      {
        "type": "shadertoy",
        "name": "schritt_01",
        "description": "Schritt 1 - Die Buehne: eine Silhouette, die das Bild sprengt (rekonstruiert aus Juggernaut-tutorial.md, SSOT dort)",
        "imageInput": [
          -1,
          -1,
          -1,
          -1
        ],
        "blend": 0,
        "code": "void mainImage(out vec4 fragColor, in vec2 fragCoord)\n{\n    // Ursprung in die Bildmitte, Teilen durch die HOEHE (unverzerrt)\n    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;\n\n    // Nachthimmel: unten leicht aufgehellt (Dunst), oben fast schwarz\n    vec3 col = mix(vec3(0.030, 0.028, 0.045), vec3(0.010, 0.012, 0.022),\n                   clamp(uv.y * 1.5 + 0.5, 0.0, 1.0));\n\n    // Der Moloch als Silhouette: Mittelpunkt UEBER der Bildmitte,\n    // Radius groesser als die halbe Bildhoehe -> der Kreis sprengt das Bild\n    vec2 zentrum = vec2(0.0, 0.55);\n    float r = length(uv - zentrum);\n    float silhouette = smoothstep(0.725, 0.715, r);\n\n    // Gegenlicht-Saum: ein schmaler, kalter Rand um die Silhouette\n    float saum = smoothstep(0.79, 0.72, r) - silhouette;\n    col += saum * vec3(0.30, 0.38, 0.55) * 0.7;\n\n    // die Silhouette selbst: fast schwarz, nur eine Spur heller als nichts\n    col = mix(col, vec3(0.012, 0.013, 0.020), silhouette);\n\n    fragColor = vec4(col, 1.0);\n}\n"
      }
    ]
  }
}
