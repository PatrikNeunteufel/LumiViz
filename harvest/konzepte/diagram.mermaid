classDiagram
%% Project: PlugInSystem (src-only, excluding /external)
%% Structs/Enums are annotated via notes for compatibility.

%% ====== Classes ======
class Application
class ServiceContainer
class IPlayerControl
class IPlayerData
class IPlaylists
class PlayerEngine
class AudioManager
class CommandBus
class EventBus
class Logger
class Settings
class MainWindow
class Menu
class WindowSystem
class FileDialogController
class UiController
class AboutDialog
class IDialog
class DialogBase
class PathDialogBase
class OpenDialog
class SaveDialog
class OpenDialogRequest
class SaveDialogRequest
class PathDialogCommon
class FileFilter
class DialogManager
class DialogDescriptor
