# C/C++ Formatting Standard
# Version: 0.1.0
# Blueprint: Documentations/Blueprints/ClangFormat_Blueprint_v0_1_0.md
# Date: 2025-12-05
# ========================================================================================

# Base style: LLVM with project-specific adjustments
BasedOnStyle: LLVM

# ========================================================================================
# Indentation and Whitespace
# ========================================================================================
TabWidth: 4
IndentWidth: 4
UseTab: Never
MaxEmptyLinesToKeep: 2
ColumnLimit: 80

# ========================================================================================
# Language Settings
# ========================================================================================
Language: Cpp
Standard: c++20

# ========================================================================================
# Pointer/Reference Alignment
# ========================================================================================
PointerAlignment: Left
DerivePointerBinding: false

# ========================================================================================
# Brace Style (Allman)
# ========================================================================================
BreakBeforeBraces: Allman
BreakBeforeTernaryOperators: false
BreakConstructorInitializersBeforeComma: false
AlwaysBreakBeforeMultilineStrings: false
AlwaysBreakTemplateDeclarations: true

# ========================================================================================
# Alignment
# ========================================================================================
AlignConsecutiveAssignments: true
AlignEscapedNewlinesLeft: true
AlignOperands: false
AlignTrailingComments: true

# ========================================================================================
# Functions and Parameters
# ========================================================================================
IndentCaseLabels: false
IndentFunctionDeclarationAfterType: false
ConstructorInitializerAllOnOneLineOrOnePerLine: false
ConstructorInitializerIndentWidth: 0
ContinuationIndentWidth: 4

# ========================================================================================
# Comments
# ========================================================================================
CommentPragmas: ''
SpacesBeforeTrailingComments: 1

# ========================================================================================
# Spacing
# ========================================================================================
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: Always
SpaceInEmptyParentheses: false
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# ========================================================================================
# Access Modifiers
# ========================================================================================
AccessModifierOffset: 0

# ========================================================================================
# Short Statements
# ========================================================================================
AllowShortCaseLabelsOnASingleLine: true
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# ========================================================================================
# Penalties
# ========================================================================================
PenaltyBreakBeforeFirstCallParameter: 100
PenaltyBreakComment: 100
PenaltyBreakFirstLessLess: 0
PenaltyBreakString: 100
PenaltyExcessCharacter: 1
PenaltyReturnTypeOnItsOwnLine: 20

# ========================================================================================
# Namespaces
# ========================================================================================
NamespaceIndentation: All

# ========================================================================================
# Include Sorting
# ========================================================================================
SortIncludes: true
IncludeBlocks: Regroup
IncludeIsMainRegex: 'pch[/\\]pch\.h'
IncludeCategories:
  - Regex:           '^"pch[/\\]pch\.h"$'
    Priority:        -1
  - Regex:           '^<.*>$'
    Priority:        1
  - Regex:           '^".*"$'
    Priority:        2

# ========================================================================================
# Arrays and Initializer Lists
# ========================================================================================
BreakArrays: true
AlignArrayOfStructures: Left
AlignAfterOpenBracket: BlockIndent
Cpp11BracedListStyle: false
SpacesInContainerLiterals: true

# ========================================================================================
# Argument/Parameter-Packing
# ========================================================================================
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# ========================================================================================
# Constructor Initializer
# ========================================================================================
PackConstructorInitializers: Never
BreakConstructorInitializers: BeforeComma
BreakBeforeBinaryOperators: None

# ========================================================================================
# Brace Wrapping (Details)
# ========================================================================================
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
